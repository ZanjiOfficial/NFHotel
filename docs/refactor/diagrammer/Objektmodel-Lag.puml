@startuml Objektmodel-Lag
' =====================================================================
' NFHotel 2.0 — Objektmodel, lagstruktur
' Genereret 2026-09-08 ud fra den faktiske kode.
'
' Klasser og interfaces på tværs af de fire lag, uden medlemslister.
' Formålet er at vise afhængighedsretningen: alt peger indad mod domænet.
' Medlemmerne findes i Objektmodel-Domaene.puml og i Modeller.md.
' =====================================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 12
skinparam ranksep 60

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #2F4739
  ArrowColor #5A615C
  FontColor #1C1F1D
  StereotypeFontColor #8A6A34
}
skinparam package {
  BackgroundColor #FCFBF8
  BorderColor #B08A4F
  FontColor #2F4739
  FontStyle bold
}
skinparam note {
  BackgroundColor #F7F5F0
  BorderColor #DDD9D0
  FontColor #5A615C
}

hide members
hide circle

title Objektmodel — lagstruktur og afhængighedsretning

' =====================================================================
package "Web · Blazor Server" as WEB {
  class BookingFlowViewModel <<viewmodel>>
  class BookingListViewModel <<viewmodel>>
  class RoomListViewModel <<viewmodel>>
  class GuestListViewModel <<viewmodel>>
  class AdminDashboardViewModel <<viewmodel>>
}

package "Infrastructure" as INF {
  class BookingRepository <<repository>>
  class RoomRepository <<repository>>
  class GuestRepository <<repository>>
  class UnitOfWork
  class SystemClock
  class HotelDbContext <<DbContext>>
  class AesGcmStringEncryptor <<security>>
}

package "Application" as APP {
  interface IBookingService <<use cases>>
  interface IRoomService <<use cases>>
  interface IGuestService <<use cases>>
  class BookingService <<service>>
  class RoomService <<service>>
  class GuestService <<service>>
  interface IBookingRepository
  interface IRoomRepository
  interface IGuestRepository
  interface IUnitOfWork
  interface IClock
}

package "Domain · kernen" as DOM {
  class Booking <<entity>>
  class Room <<entity>>
  class Guest <<entity>>
  class DateRange <<value object>>
  class BookingRules <<static>>
}

' =====================================================================
' Web kender kun use case-interfaces
' =====================================================================
BookingFlowViewModel ..> IBookingService
BookingFlowViewModel ..> IGuestService
BookingListViewModel ..> IBookingService
RoomListViewModel ..> IRoomService
GuestListViewModel ..> IGuestService
AdminDashboardViewModel ..> IBookingService
AdminDashboardViewModel ..> IRoomService

' =====================================================================
' Application implementerer sine egne kontrakter og bruger domænet
' =====================================================================
BookingService ..|> IBookingService
RoomService ..|> IRoomService
GuestService ..|> IGuestService

BookingService --> IBookingRepository
BookingService --> IUnitOfWork
BookingService --> IClock
RoomService --> IRoomRepository
GuestService --> IGuestRepository

BookingService ..> Booking
BookingService ..> BookingRules
RoomService ..> Room
GuestService ..> Guest

' =====================================================================
' Infrastructure implementerer Applications kontrakter — peger indad
' =====================================================================
BookingRepository ..|> IBookingRepository
RoomRepository ..|> IRoomRepository
GuestRepository ..|> IGuestRepository
UnitOfWork ..|> IUnitOfWork
SystemClock ..|> IClock

BookingRepository --> HotelDbContext
RoomRepository --> HotelDbContext
GuestRepository --> HotelDbContext
UnitOfWork --> HotelDbContext
HotelDbContext ..> AesGcmStringEncryptor

' =====================================================================
note bottom of DOM
  **Domain har udgrad nul.** Ingen projektreferencer, ingen NuGet-pakker.
end note

note bottom of INF
  Repository-**interfaces** bor i Application, **implementeringerne** her.
  Det er derfor pilene fra Infrastructure peger indad og ikke omvendt.
  Haandhaeves af arkitekturtests i Application.Tests — ikke af disciplin.
end note

' Skjulte kanter der tvinger lagene i lodret orden
BookingFlowViewModel -[hidden]down- IBookingService
IBookingService -[hidden]down- BookingService
BookingService -[hidden]down- Booking
BookingRepository -[hidden]down- HotelDbContext

@enduml
