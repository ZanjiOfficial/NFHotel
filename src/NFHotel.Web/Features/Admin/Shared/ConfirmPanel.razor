@*
    Bekræftelse før en handling der ikke kan fortrydes: annullering af en booking (BR-04)
    og sletning af en gæst eller et rum.

    Panelet er en indlejret stribe og ikke et overlay. En modal ville kræve klasser der
    ikke findes i designsystemet (UI-Spec afsnit 3 er kontrakten), og et overlay i Blazor
    Server bliver stående efter navigation, fordi DOM'en overlever sideskiftet. Striben
    står i stedet dér hvor rækken står, og forsvinder når listen hentes igen.

    Ingen logik: hvad der skal bekræftes, og hvad der sker bagefter, afgøres af den
    viewmodel der åbnede panelet.
*@

<div class="alert alert-error" role="alertdialog" aria-label="@Title">
    <p><strong>@Title</strong></p>

    <p>@Message</p>

    <div class="row">
        <button type="button"
                class="btn btn-danger btn-sm"
                disabled="@IsBusy"
                @onclick="OnConfirm">
            @ConfirmLabel
        </button>

        <button type="button"
                class="btn btn-secondary btn-sm"
                disabled="@IsBusy"
                @onclick="OnCancel">
            Go back
        </button>
    </div>
</div>

@code {
    /// <summary>Overskriften, fx "Annullér booking FLZ-000123?".</summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Forklaringen af hvad der sker hvis brugeren fortsætter.</summary>
    [Parameter]
    [EditorRequired]
    public string Message { get; set; } = string.Empty;

    /// <summary>Teksten på den bekræftende knap. Skal navngive handlingen, ikke sige "OK".</summary>
    [Parameter]
    public string ConfirmLabel { get; set; } = "Confirm";

    /// <summary>Deaktiverer begge knapper mens et kald er i gang.</summary>
    [Parameter]
    public bool IsBusy { get; set; }

    /// <summary>Kaldes når brugeren bekræfter.</summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>Kaldes når brugeren fortryder.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }
}
