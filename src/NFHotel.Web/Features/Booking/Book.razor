@page "/book"
@rendermode InteractiveServer

@inject BookingFlowViewModel ViewModel
@inject NavigationManager Navigation

@*
    Kundens bookingflow: datoer → ledige rum → oplysninger → kvittering, på én side.

    Filen er markup. Al tilstand, al validering og alle servicekald ligger i
    BookingFlowViewModel (UI-Spec afsnit 4, B-10). @code herunder indeholder kun
    viderestillinger og den ene navigation der hører til browseren.

    PublicLayout er standardlayout (Routes.razor), så der er ingen @@layout-linje.

    Trinnene kan ikke springes over: knappen til trin 2 er deaktiveret indtil datoerne er
    gyldige, og viewmodellen kontrollerer dem igen ved hver overgang (BR-C-04).
*@

<PageTitle>Book your stay — NFHotel</PageTitle>

<div class="page-narrow stack-lg">
    <PageHeader Title="Book your stay"
                Subtitle="Four steps, no account needed. Reception confirms your booking once we've seen it." />

    <ol class="steps" aria-label="Booking steps">
        <li class="@ViewModel.StepClass(BookingFlowStep.Dates)"
            aria-current="@ViewModel.StepAria(BookingFlowStep.Dates)">Dates</li>
        <li class="@ViewModel.StepClass(BookingFlowStep.Room)"
            aria-current="@ViewModel.StepAria(BookingFlowStep.Room)">Room</li>
        <li class="@ViewModel.StepClass(BookingFlowStep.Guest)"
            aria-current="@ViewModel.StepAria(BookingFlowStep.Guest)">Your details</li>
        <li class="@ViewModel.StepClass(BookingFlowStep.Receipt)"
            aria-current="@ViewModel.StepAria(BookingFlowStep.Receipt)">Confirmation</li>
    </ol>

    <ErrorAlert Errors="ViewModel.Errors" />

    @if (ViewModel.CurrentStep == BookingFlowStep.Dates)
    {
        <section class="card card-pad stack" aria-labelledby="step-dates">
            <h2 class="subtitle" id="step-dates">When would you like to stay?</h2>

            <div class="field-row">
                <FormField Label="Check-in" For="check-in" IsRequired="true" Error="@ViewModel.CheckInError">
                    <input id="check-in"
                           class="field-input numeric"
                           type="date"
                           disabled="@ViewModel.IsBusy"
                           aria-invalid="@Invalid(ViewModel.CheckInError)"
                           @bind="ViewModel.CheckInDate" />
                </FormField>

                <FormField Label="Check-out" For="check-out" IsRequired="true" Error="@ViewModel.CheckOutError"
                           Hint="The day you leave doesn't count as a night.">
                    <input id="check-out"
                           class="field-input numeric"
                           type="date"
                           disabled="@ViewModel.IsBusy"
                           aria-invalid="@Invalid(ViewModel.CheckOutError)"
                           @bind="ViewModel.CheckOutDate" />
                </FormField>
            </div>

            <p class="muted" role="status">@ViewModel.NightsText</p>

            <div class="row">
                <button type="button"
                        class="btn btn-primary"
                        disabled="@(!ViewModel.CanFindRooms)"
                        @onclick="FindRoomsAsync">
                    Find available rooms
                </button>
            </div>
        </section>
    }
    else if (ViewModel.CurrentStep == BookingFlowStep.Room)
    {
        <section class="card card-pad stack" aria-labelledby="step-room">
            <div class="row-between">
                <h2 class="subtitle" id="step-room">Choose a room</h2>
                <p class="muted numeric">@ViewModel.PeriodText &middot; @ViewModel.NightsText</p>
            </div>

            @if (ViewModel.IsBusy)
            {
                @* Pladsholdere i kortenes form, så listen ikke skubber siden når den lander. *@
                <LoadingSkeleton Rows="6" />
            }
            else if (ViewModel.AvailableRooms.Count == 0)
            {
                @* Ingen ledige værelser er ikke en fejl — det er et svar på et spørgsmål. *@
                <EmptyState Title="No rooms are free for those dates"
                            Description="Try a day or two either side, or shorten the stay. If your dates can't move, email help@nfhotel.com and reception will look for something.">
                    <button type="button" class="btn btn-primary" @onclick="BackToDates">
                        Pick other dates
                    </button>
                </EmptyState>
            }
            else
            {
                <div class="grid-auto">
                    @foreach (var room in ViewModel.AvailableRooms)
                    {
                        <article class="roomcard card-hover">
                            <div class="roomcard-media" aria-hidden="true">
                                @DisplayText.Describe(room.Size)
                            </div>

                            <div class="stack-sm">
                                <h3 class="subtitle">Room @room.RoomNumber</h3>
                                <p class="muted">
                                    @DisplayText.Describe(room.Size)
                                    &middot; @BookingFlowViewModel.DescribeFloor(room.Floor)
                                    &middot; @BookingFlowViewModel.DescribeCapacity(room.Capacity)
                                </p>
                                <p class="muted">@BookingFlowViewModel.PaymentText</p>
                            </div>

                            <div class="row">
                                <button type="button"
                                        class="btn btn-primary btn-block"
                                        disabled="@ViewModel.IsBusy"
                                        @onclick="() => ViewModel.SelectRoom(room.RoomId)">
                                    Choose room @room.RoomNumber
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }

            <div class="row">
                <button type="button" class="btn btn-ghost" disabled="@ViewModel.IsBusy" @onclick="BackToDates">
                    Back to dates
                </button>
            </div>
        </section>
    }
    else if (ViewModel.CurrentStep == BookingFlowStep.Guest)
    {
        <section class="card card-pad stack" aria-labelledby="step-details">
            <h2 class="subtitle" id="step-details">Your details</h2>
            <p class="muted">@ViewModel.SelectionSummary</p>

            <div class="field-row">
                <FormField Label="First name" For="first-name" IsRequired="true" Error="@ViewModel.GuestErrors.FirstName">
                    <input id="first-name"
                           class="field-input"
                           type="text"
                           autocomplete="given-name"
                           disabled="@ViewModel.IsBusy"
                           aria-invalid="@Invalid(ViewModel.GuestErrors.FirstName)"
                           @bind="ViewModel.FirstName" />
                </FormField>

                <FormField Label="Last name" For="last-name" IsRequired="true" Error="@ViewModel.GuestErrors.LastName">
                    <input id="last-name"
                           class="field-input"
                           type="text"
                           autocomplete="family-name"
                           disabled="@ViewModel.IsBusy"
                           aria-invalid="@Invalid(ViewModel.GuestErrors.LastName)"
                           @bind="ViewModel.LastName" />
                </FormField>
            </div>

            <div class="field-row">
                <FormField Label="Email" For="email" IsRequired="true" Error="@ViewModel.GuestErrors.Email"
                           Hint="We'll send your confirmation here.">
                    <input id="email"
                           class="field-input"
                           type="email"
                           autocomplete="email"
                           disabled="@ViewModel.IsBusy"
                           aria-invalid="@Invalid(ViewModel.GuestErrors.Email)"
                           @bind="ViewModel.Email" />
                </FormField>

                <FormField Label="Phone" For="phone" IsRequired="true" Error="@ViewModel.GuestErrors.PhoneNumber">
                    <input id="phone"
                           class="field-input"
                           type="tel"
                           autocomplete="tel"
                           disabled="@ViewModel.IsBusy"
                           aria-invalid="@Invalid(ViewModel.GuestErrors.PhoneNumber)"
                           @bind="ViewModel.PhoneNumber" />
                </FormField>
            </div>

            <div class="field-row">
                <FormField Label="Country" For="country" IsRequired="true" Error="@ViewModel.GuestErrors.Country">
                    <input id="country"
                           class="field-input"
                           type="text"
                           autocomplete="country-name"
                           disabled="@ViewModel.IsBusy"
                           aria-invalid="@Invalid(ViewModel.GuestErrors.Country)"
                           @bind="ViewModel.Country" />
                </FormField>

                <FormField Label="Passport number" For="passport" Error="@ViewModel.GuestErrors.PassportNumber"
                           Hint="Optional. It speeds up check-in at the front desk.">
                    <input id="passport"
                           class="field-input"
                           type="text"
                           disabled="@ViewModel.IsBusy"
                           aria-invalid="@Invalid(ViewModel.GuestErrors.PassportNumber)"
                           @bind="ViewModel.PassportNumber" />
                </FormField>
            </div>

            <p class="field-hint">
                Your booking starts out as "Pending". Reception confirms it once we've seen it.
                @BookingFlowViewModel.PaymentText.
            </p>

            <div class="row">
                <button type="button"
                        class="btn btn-primary"
                        disabled="@(!ViewModel.CanSubmit)"
                        @onclick="SubmitAsync">
                    Send booking request
                </button>

                <button type="button" class="btn btn-ghost" disabled="@ViewModel.IsBusy" @onclick="BackToRooms">
                    Back to rooms
                </button>
            </div>
        </section>
    }
    else
    {
        <section class="stack" aria-labelledby="step-confirmation">
            <AlertBox Kind="AlertKind.Ok"
                      Message="Thank you — we've got your booking request. Reception will confirm it shortly." />

            <h2 class="subtitle" id="step-confirmation">Your confirmation</h2>

            <BookingReceiptCard Details="ViewModel.Confirmation" />

            <div class="row">
                <a class="btn btn-secondary" href="@ReceiptUrl">Open the confirmation on its own page</a>
                <button type="button" class="btn btn-ghost" @onclick="StartOver">Book another stay</button>
            </div>
        </section>
    }
</div>

@code {
    /// <summary>Markerer et input som ugyldigt for skærmlæsere, eller udelader attributten.</summary>
    private static string? Invalid(string? error) => error is null ? null : "true";

    /// <summary>Adressen på den bogmærkbare kvittering for den netop oprettede booking.</summary>
    private string ReceiptUrl =>
        ViewModel.Confirmation is null ? "/book" : $"/booking/{ViewModel.Confirmation.BookingNumber}";

    private Task FindRoomsAsync() => ViewModel.FindRoomsAsync();

    private void BackToDates() => ViewModel.BackToDates();

    private void BackToRooms() => ViewModel.BackToRooms();

    private void StartOver() => ViewModel.StartOver();

    /// <summary>
    /// Sender bestillingen og fører kunden videre til den bogmærkbare kvittering.
    /// </summary>
    /// <remarks>
    /// Navigationen ligger her og ikke i viewmodellen: en URL er browserens begreb, ikke
    /// bookingens. Trin 4 tegnes alligevel først, så kvitteringen står på skærmen, også
    /// hvis navigationen skulle nå at fejle.
    /// </remarks>
    private async Task SubmitAsync()
    {
        await ViewModel.SubmitAsync();

        if (ViewModel.Confirmation is not null)
        {
            Navigation.NavigateTo(ReceiptUrl);
        }
    }
}
