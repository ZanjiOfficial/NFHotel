@inherits LayoutComponentBase

@*
    Hotellets ansigt udadtil. Ingen sidemenu, ingen værktøjslinje — en topbar, indholdet
    centreret i --maxw, og en diskret bund. Alt der ligner personalets arbejdsværktøj
    hører i AdminLayout.
*@

<a class="skip-link" href="#content">Skip to content</a>

<header class="site-header">
    <div class="row-between">
        <a class="site-brand" href="/">NFHotel &amp; Bar</a>

        <nav class="site-nav" aria-label="Primary">
            <a class="btn btn-primary" href="/book">Book your stay</a>
        </nav>
    </div>
</header>

<main id="content">
    @Body
</main>

<footer class="site-footer">
    <div class="row-between">
        <p>
            NFHotel &amp; Bar &middot; Street 172, Phnom Penh, Cambodia &middot;
            <a href="mailto:help@nfhotel.com">help@nfhotel.com</a>
        </p>
        <p>Bar, kitchen and reception open around the clock</p>
    </div>
</footer>

@*
    Sidste net under fejlhåndteringen: fanger det ingen ViewModel kunne oversætte til en
    fejlkode. Teksten er neutral og afslører aldrig en exception (Conventions.md).
*@
<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#128473;</span>
</div>
