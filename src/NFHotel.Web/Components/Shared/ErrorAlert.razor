@*
    Neutral fejlvisning for en ViewModels fejlliste. Tager færdigoversatte danske tekster
    og viser dem. Komponenten oversætter ikke selv og kender ingen fejlkoder — det er
    ErrorMessages' job.

    Til en enkelt besked med valgfri alvorlighedsgrad bruges AlertBox i stedet.
*@

@if (Errors.Count > 0)
{
    <div class="alert alert-error" role="alert">
        @if (Errors.Count == 1)
        {
            <p>@Errors[0]</p>
        }
        else
        {
            <ul>
                @foreach (var message in Errors)
                {
                    <li>@message</li>
                }
            </ul>
        }
    </div>
}

@code {
    /// <summary>De danske fejltekster der skal vises. Tom liste skjuler komponenten.</summary>
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<string> Errors { get; set; } = Array.Empty<string>();
}
