@*
    Én besked med en alvorlighedsgrad. Til lister af fejl fra en ViewModel bruges
    ErrorAlert; denne er til den enkelte kvittering, advarsel eller oplysning.

    Komponenten oversætter ikke fejlkoder — teksten skal være færdig dansk (ErrorMessages).
*@

@if (!string.IsNullOrWhiteSpace(Message) || ChildContent is not null)
{
    <div class="@BadgeClass.For(Kind)" role="@Role">
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p>@Message</p>
        }
        @ChildContent
    </div>
}

@code {
    /// <summary>Beskedens alvorlighedsgrad. Styrer farve og oplæsning.</summary>
    [Parameter]
    public AlertKind Kind { get; set; } = AlertKind.Info;

    /// <summary>Den danske besked. Tom besked uden indhold skjuler komponenten.</summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>Valgfrit ekstra indhold, fx et link eller en knap under beskeden.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Fejl annonceres med det samme; resten venter til skærmlæseren er færdig.
    /// </summary>
    private string Role => Kind == AlertKind.Error ? "alert" : "status";
}
